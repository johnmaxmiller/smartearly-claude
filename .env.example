# Google OAuth credentials (from https://console.developers.google.com/)
# Add these exact values as Vercel environment variables
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# NextAuth.js v5 secret — generate with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Production URL (set this on Vercel too)
AUTH_URL=https://your-vercel-app.vercel.app

# Google Cloud Console setup:
#   Authorized JavaScript origins: https://your-vercel-app.vercel.app
#   Authorized redirect URIs:      https://your-vercel-app.vercel.app/api/auth/callback/google
